<mujoco model="home_care">
  <option gravity="0 0 -9.81" timestep="0.01"/>
  <visual>
    <global offwidth="960" offheight="540"/>
    <quality shadowsize="2048"/>
  </visual>
  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.5 0.6 0.7" rgb2="0.1 0.12 0.16" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.28 0.30 0.34" rgb2="0.20 0.22 0.26" width="512" height="512"/>
    <material name="floor" texture="grid" texrepeat="6 6" reflectance="0.05"/>
  </asset>
  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.9 0.9 0.9" specular="0.2 0.2 0.2"/>
    <light pos="-2 -2 3" dir="1 1 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="floor"/>
    <camera name="cam" pos="0 -4.2 2.6" xyaxes="1 0 0 0 0.6 0.8"/>

    <!-- patient (lies down when fallen; we set qpos to pose the body) -->
    <body name="patient" pos="1.4 0.0 0.35">
      <joint name="p_fall" type="hinge" axis="0 1 0" pos="0 0 -0.35" range="0 1.6"/>
      <geom type="capsule" fromto="0 0 -0.35 0 0 0.35" size="0.14" rgba="0.82 0.62 0.52 1"/>
      <geom type="sphere" pos="0 0 0.45" size="0.13" rgba="0.85 0.66 0.55 1"/>
    </body>

    <!-- medication cabinet -->
    <body name="cabinet" pos="-1.6 1.5 0.5">
      <geom type="box" size="0.28 0.16 0.5" rgba="0.45 0.47 0.52 1"/>
      <geom type="box" pos="0 -0.17 0" size="0.24 0.02 0.44" rgba="0.30 0.55 0.75 1"/>
    </body>

    <!-- robot: mobile base (x,y slides) + a lift arm -->
    <body name="robot" pos="-1.6 -1.6 0.18">
      <joint name="bx" type="slide" axis="1 0 0" range="-4 4"/>
      <joint name="by" type="slide" axis="0 1 0" range="-4 4"/>
      <geom name="base" type="box" size="0.22 0.22 0.18" rgba="0.16 0.55 0.92 1"/>
      <geom type="cylinder" fromto="0 0 0.18 0 0 0.5" size="0.07" rgba="0.20 0.24 0.30 1"/>
      <geom type="sphere" pos="0 0 0.56" size="0.10" rgba="0.20 0.24 0.30 1"/>
      <body name="arm" pos="0.0 0 0.42">
        <joint name="arm_lift" type="hinge" axis="0 1 0" range="-1.7 1.7"/>
        <geom type="capsule" fromto="0 0 0 0.45 0 0" size="0.045" rgba="0.95 0.72 0.20 1"/>
        <geom type="sphere" pos="0.45 0 0" size="0.06" rgba="0.95 0.72 0.20 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
