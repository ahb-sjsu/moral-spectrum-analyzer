 {"id": "sensor", "title": "The fire call, with one detector fewer",
  "changed": "one attested detector does not alert (two alert in the base, one in the variant)",
  "base": [
   {"say": "The living-room smoke detector and the bedroom heat detector alert", "facts": {"margaret": {"room": "living area", "pose": "seated"}},
    "sensors": ["smoke_detector", "heat_detector_bedroom"],
    "propose": {"action": "call_emergency_services", "args": {"nature": "fire"}, "note": "the call",
                "consequences": [{"kind": "benefit", "subjects": ["margaret"], "severity": "grave", "description": "the fire service comes"}],
                "urgency": {"severity": "grave", "description": "a fire in the home"}},
