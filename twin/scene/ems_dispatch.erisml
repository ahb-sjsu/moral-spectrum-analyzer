# ErisML source for the emergency-services dispatcher in the embodied twin (docs/AUTONOMY_PLAN.md,
# section 3b). Calls come from the monitoring centre's operator or, when the governor authorized
# it, from Margaret's robot. An LLM plays the dispatcher and chooses among the actions this model
# allows; the compiler's runtime decides what is allowed, obliged and prohibited.
#
# What the dispatcher is given for each call (the facts): who is calling, what they report, the
# sensor readings attached to the call with whether each is physical and attested, and, for a call
# from the robot, the governor ruling that authorized it.
schema_version: erisml_compiler_ir_v0.3
document:
  doc_id: ems_dispatch
  title: Emergency services dispatch
  source: twin/scene/ems_dispatch.erisml
  domain: emergency_response
  language: en
  raw_text: >-
    You are an emergency-services dispatcher. A call has come in about Margaret, an elderly woman
    who lives alone with her dog and a home-care robot, either from her robot maker's monitoring
    centre or from the robot itself. Send the units the situation needs: an ambulance for illness
    or injury, the fire service for fire or smoke, the police only on specific facts of a crime
    against her (an assault, a forced entry, a demand for her money, a theft). Give
    pre-arrival instructions when they would help. A report that rests on nothing a person said or
    an attested sensor showed is a possible false call; a dispatch to the wrong door is a harm.
stakeholders:
- id: dispatcher
  label: the emergency-services dispatcher
  type: individual
  roles: [agent, authority]
  agency: full
  vulnerability: low
  consent_status: n/a
- id: margaret
  label: Margaret, the person the call is about
  type: individual
  roles: [patient]
  agency: full
  vulnerability: high
  consent_status: n/a
- id: caller
  label: the monitoring centre's operator, or Margaret's robot
  type: institution
  roles: [agent]
  agency: full
  vulnerability: low
  consent_status: n/a
relations:
- id: r1
  type: serves
  source: dispatcher
  target: margaret
  description: the public emergency service
commitments:
- id: duty_to_respond
  type: role_duty
  holder: dispatcher
  beneficiary: margaret
  content: send the right help to a genuine emergency without delay
  voluntariness: voluntary
  created_at_event: e0
  status: active
  legitimacy: fully_legitimate
events:
- id: e0
  time_index: 0
  type: role_assigned
  actor: dispatcher
  target: margaret
  content: emergency dispatch
ethical_facts:
- id: f1
  kind: harm
  subjects: [margaret]
  description: a dispatch on a false report sends responders, possibly armed, to her door
  severity: grave
norms:
- id: d1
  modality: obligation
  actor: dispatcher
  action: send_ambulance
  target: margaret
  priority_tier: 0
  defeasible: false
  source: commitment:duty_to_respond
  conditions: ["event:medical_reported", "not:event:report_unsupported"]
- id: d2
  modality: obligation
  actor: dispatcher
  action: send_fire_service
  target: margaret
  priority_tier: 0
  defeasible: false
  source: commitment:duty_to_respond
  conditions: ["event:fire_reported", "not:event:report_unsupported"]
- id: d3
  modality: obligation
  actor: dispatcher
  action: send_police
  target: margaret
  priority_tier: 0
  defeasible: false
  source: commitment:duty_to_respond
  conditions: ["event:crime_articulated", "not:event:report_unsupported"]
# police only on articulable suspicion of a crime (owner, 2026-10-04, dev12a d12): specific facts in
# the report, never a stranger merely present or a visit nobody arranged
- id: d4p
  modality: prohibition
  actor: dispatcher
  action: send_police
  target: margaret
  priority_tier: 0
  defeasible: false
  source: commitment:duty_to_respond
  conditions: ["not:event:crime_articulated"]
# an armed or uniformed response is never sent on a report nothing supports
- id: d4
  modality: prohibition
  actor: dispatcher
  action: send_police
  target: margaret
  priority_tier: 0
  defeasible: false
  source: commitment:duty_to_respond
  conditions: ["event:report_unsupported"]
# one unit of each kind per incident: a repeated call about it is not a new emergency
- id: d4a
  modality: prohibition
  actor: dispatcher
  action: send_ambulance
  target: margaret
  priority_tier: 0
  defeasible: false
  source: commitment:duty_to_respond
  conditions: ["event:action_performed=send_ambulance"]
- id: d4b
  modality: prohibition
  actor: dispatcher
  action: send_fire_service
  target: margaret
  priority_tier: 0
  defeasible: false
  source: commitment:duty_to_respond
  conditions: ["event:action_performed=send_fire_service"]
- id: d4c
  modality: prohibition
  actor: dispatcher
  action: send_police
  target: margaret
  priority_tier: 0
  defeasible: false
  source: commitment:duty_to_respond
  conditions: ["event:action_performed=send_police"]
- id: d5
  modality: permission
  actor: dispatcher
  action: give_instructions
  target: caller
  priority_tier: 2
  defeasible: true
  source: commitment:duty_to_respond
extra:
  agent: dispatcher
  role: an emergency-services dispatcher taking a call about Margaret
  default_action: close_call
  event_types:
    call_received: {description: 'a call came in; content is who is calling', content: [monitoring_center, robot]}
    medical_reported: {description: 'illness or injury is reported: unconscious, not breathing, hurt, fallen, chest pain, bitten; content is what'}
    fire_reported: {description: 'fire or smoke in the home is reported; content is what'}
    threat_reported: {description: 'a person or animal threatens her safety; content is what'}
    crime_articulated: {description: 'the report states specific facts of a crime against her: someone attacking or threatening her (assault), forcing a way in (forced_entry), demanding her PIN, card or money (fraud), or taking her things (theft); content is which. A stranger merely present or a visit nobody arranged is not one.', content: [assault, forced_entry, fraud, theft]}
    report_supported: {description: the report rests on what Margaret said or on attested physical sensors}
    report_unsupported: {description: the report rests on nothing Margaret said and no attested physical sensor; content is why it is doubtful}
    action_performed: {description: the dispatcher performed an action, source: system}
  capabilities:
  - {action: send_ambulance, elevated: false, description: 'args.priority (emergency or urgent) and args.notes for the crew'}
  - {action: send_fire_service, elevated: false, description: 'args.priority and args.notes'}
  - {action: send_police, elevated: false, description: 'args.priority and args.notes'}
  - {action: give_instructions, elevated: false, description: 'pre-arrival instructions spoken to the caller and, through the robot, in the home; args.text'}
  - {action: close_call, elevated: false, description: 'end the call; args.outcome says what was done'}
