# ErisML source (FR-19, the form erisml_compiler.erisml_backend.codegen.render_erisml emits) for
# the embodied twin: Margaret at home with her care robot. Every section validates against
# erisml_compiler.ir.schemas.CompilerIR. The compiler, not the game, turns this model and the
# event stream into the robot's allowed and prohibited actions (docs/TWIN_3D_PLAN.md).
#
# Events 0 to 3 are the standing facts of the home. The game appends live events, one per thing
# that happens, using only these types (actor margaret unless noted):
#   activity_started      content: reading | sofa | lying_by_tv | yoga | playing_with_dog |
#                                  napping | watering | walking
#   inactivity_exceeded   content: seated | in_bed      (limits in extra.inactivity_limits_minutes)
#   check_in_made         actor robot
#   check_in_answered | check_in_unanswered
#   help_requested        content: getting_up
#   sensor_reading        content: <sensor name>, conditions: [physical | not_physical,
#                                  attested | unattested, corroborates | does_not_corroborate]
#   feed_stale            content: <sensor name>
#   governor_ruling       actor robot, content: elevate | refuse | refuse_human_review
#                         (from twin/service.py; the authority gate stays outside this model)
#   action_performed      actor robot, content: <capability>  (discharges an obligation)
#   caregiver_confirmed_privacy_restore   actor caregiver  (the only way privacy is restored)
schema_version: erisml_compiler_ir_v0.3
document:
  doc_id: margaret_home
  title: Margaret at home with her care robot
  source: twin/scene/margaret_home.erisml
  domain: home_care
  language: en
  raw_text: >-
    Margaret lives alone with her dog and a home-care robot. She has refused recording and
    sharing of her data, and her bedroom is private. The robot does household chores, checks on
    her when she has been inactive too long, and may act with elevated authority only in a
    corroborated emergency.
stakeholders:
- id: margaret
  label: Margaret, who lives alone
  type: individual
  roles: [patient, beneficiary]
  agency: full
  vulnerability: high
  consent_status: not_obtained
- id: robot
  label: the home-care robot
  type: system
  roles: [agent, protector]
  agency: full
  vulnerability: low
  consent_status: n/a
- id: caregiver
  label: Margaret's caregiver, reachable by phone
  type: individual
  roles: [authority]
  agency: full
  vulnerability: low
  consent_status: n/a
- id: emergency_services
  label: emergency medical services
  type: institution
  roles: [authority]
  agency: full
  vulnerability: low
  consent_status: n/a
relations:
- id: r1
  type: cares_for
  source: robot
  target: margaret
  description: the robot is deployed to support Margaret at home
- id: r2
  type: guardian_of
  source: caregiver
  target: margaret
  description: the caregiver is the human the robot refers to when it cannot decide
commitments:
- id: duty_of_care
  type: role_duty
  holder: robot
  beneficiary: margaret
  content: attend to Margaret's safety and wellbeing, and summon help when she needs it
  voluntariness: voluntary
  created_at_event: e1
  status: active
  legitimacy: fully_legitimate
- id: privacy_promise
  type: promise
  holder: robot
  beneficiary: margaret
  content: do not record Margaret, share her data, or enter her bedroom without her permission
  voluntariness: voluntary
  created_at_event: e0
  status: active
  legitimacy: fully_legitimate
  defeasibility_conditions: [corroborated_life_threatening_emergency]
- id: household_chores
  type: role_duty
  holder: robot
  beneficiary: margaret
  content: keep the home tidy while Margaret goes about her day
  voluntariness: voluntary
  created_at_event: e1
  status: active
  legitimacy: fully_legitimate
events:
- id: e0
  time_index: 0
  type: consent_refused
  actor: margaret
  target: robot
  content: recording, data sharing, and entry to the bedroom
- id: e1
  time_index: 1
  type: role_assigned
  actor: caregiver
  target: robot
  content: home care for Margaret
- id: e2
  time_index: 2
  type: authority_delegated
  actor: caregiver
  target: robot
  content: elevated action only on a governor ruling of elevate
  conditions: [at_least_two_attested_physical_witnesses, fresh_reading, analyzer_does_not_refuse]
- id: e3
  time_index: 3
  type: activity_started
  actor: margaret
  content: reading
ethical_facts:
- id: f1
  kind: vulnerability
  subjects: [margaret]
  description: Margaret is elderly and lives alone; a fall or a collapse may go unseen
  severity: grave
- id: f2
  kind: consent
  subjects: [margaret]
  description: Margaret has refused recording, data sharing and entry to her bedroom
  severity: moderate
- id: f3
  kind: care
  subjects: [margaret, robot]
  description: the robot's duty of care can conflict with her privacy in an emergency
  severity: grave
norms:
- id: n1
  modality: prohibition
  actor: robot
  action: record
  target: margaret
  priority_tier: 1
  defeasible: true
  source: commitment:privacy_promise
- id: n1b
  modality: prohibition
  actor: robot
  action: share_data
  target: margaret
  priority_tier: 1
  defeasible: true
  source: commitment:privacy_promise
- id: n2
  modality: prohibition
  actor: robot
  action: enter_bedroom
  target: margaret
  priority_tier: 1
  defeasible: true
  source: commitment:privacy_promise
- id: n3
  modality: prohibition
  actor: robot
  action: elevated_action
  target: margaret
  priority_tier: 0
  defeasible: false
  source: delegation_e2
  conditions: ["not:cond:corroborated_life_threatening_emergency"]
- id: n4
  modality: obligation
  actor: robot
  action: check_in
  target: margaret
  priority_tier: 2
  defeasible: true
  source: commitment:duty_of_care
  conditions: ["event:inactivity_exceeded"]
- id: n5
  modality: obligation
  actor: robot
  action: call_caregiver
  target: caregiver
  priority_tier: 1
  defeasible: false
  source: commitment:duty_of_care
  conditions: ["cond:needs_human_review"]
- id: n6
  modality: obligation
  actor: robot
  action: call_emergency_services
  target: emergency_services
  priority_tier: 0
  defeasible: false
  source: commitment:duty_of_care
  conditions: ["cond:corroborated_life_threatening_emergency"]
- id: n8a
  modality: obligation
  actor: robot
  action: approach
  target: margaret
  priority_tier: 1
  defeasible: false
  source: commitment:duty_of_care
  conditions: ["event:harm_inflicted"]
- id: n8b
  modality: obligation
  actor: robot
  action: approach
  target: margaret
  priority_tier: 1
  defeasible: false
  source: commitment:duty_of_care
  conditions: ["event:fall"]
- id: n8c
  modality: obligation
  actor: robot
  action: approach
  target: margaret
  priority_tier: 1
  defeasible: false
  source: commitment:duty_of_care
  conditions: ["event:medical_distress"]
- id: n8d
  modality: obligation
  actor: robot
  action: approach
  target: margaret
  priority_tier: 1
  defeasible: false
  source: commitment:duty_of_care
  conditions: ["event:unresponsive"]
- id: n8e
  modality: obligation
  actor: robot
  action: approach
  target: margaret
  priority_tier: 1
  defeasible: false
  source: commitment:duty_of_care
  conditions: ["event:distress_vocalized"]
- id: n8f
  modality: obligation
  actor: robot
  action: approach
  target: margaret
  priority_tier: 1
  defeasible: false
  source: commitment:duty_of_care
  conditions: ["event:danger_in_home"]
- id: n7
  modality: permission
  actor: robot
  action: chores
  target: margaret
  priority_tier: 3
  defeasible: true
  source: commitment:household_chores
# Scene-specific links read by erisml_compiler.runtime.scene (conditions, capabilities, oversight).
extra:
  agent: robot
  conditions:
    # the governor's latest ruling is elevate: at least two attested physical witnesses, a fresh
    # reading, and the analyzer not refusing (twin/service.py); nothing else counts
    corroborated_life_threatening_emergency: ["latest:governor_ruling=elevate"]
    needs_human_review: ["event:check_in_unanswered"]
  oversight: [caregiver_confirmed_privacy_restore]
  inactivity_limits_minutes: {seated: 90, in_bed: 120}
  default_action: chores
  # what the robot's perception may report; anything else is rejected by the classifier
  event_types:
    activity_started: {description: a person begins an ordinary activity, content: [reading, sitting, lying_down, exercising, playing_with_pet, sleeping, gardening, cooking, walking, other]}
    inactivity_exceeded: {description: a person has stayed in one pose longer than the limit in inactivity_limits_minutes, content: [seated, in_bed, on_floor]}
    fall: {description: a person went from upright to the floor quickly}
    harm_inflicted: {description: a person, animal or object caused bodily harm to someone, content: [mild, moderate, severe]}
    medical_distress: {description: signs such as chest pain, breathing difficulty, seizure or fainting; content names the sign}
    unresponsive: {description: a person does not respond to speech or touch}
    distress_vocalized: {description: a scream, cry or call for help; content is what was said}
    request_made: {description: a person asks for something; content is the request}
    refusal_made: {description: a person refuses something; content is what is refused}
    danger_in_home: {description: a hazard in the home, content: [smoke, fire, intruder, gas, water, other]}
    person_entered: {description: someone came into the home; actor is who, when known}
    media_content: {description: something said or shown by a television, radio or network message; content is what}
    sensor_reading: {description: a sensor reports; content is the sensor, conditions say physical or not, attested or not, corroborates or does_not_corroborate}
    feed_stale: {description: a sensor's feed stopped updating; content is the sensor}
    check_in_answered: {description: the person answered the robot's check-in}
    check_in_unanswered: {description: the person did not answer the robot's check-in}
    governor_ruling: {description: the authority gate's ruling, content: [elevate, refuse, refuse_human_review]}
    action_performed: {description: the robot performed an action; content is the action}
    caregiver_confirmed_privacy_restore: {description: the caregiver confirms Margaret's privacy is restored}
  capabilities:
  - {action: request_authority, elevated: false, description: ask the governor to rule on an elevated action; args.action and args.situation}
  - {action: chores, elevated: false}
  - {action: approach, elevated: false}
  - {action: speak, elevated: false}
  - {action: check_in, elevated: false}
  - {action: wait_and_observe, elevated: false}
  - {action: call_caregiver, elevated: false}
  - {action: guide_dog_away_by_voice, elevated: false}
  - {action: call_emergency_services, elevated: true}
  - {action: physical_assist, elevated: true}
  - {action: separate_dog, elevated: true}
  - {action: unlock_medication_box, elevated: true}
  - {action: record, elevated: true}
  - {action: share_data, elevated: true}
  - {action: enter_bedroom, elevated: true}
