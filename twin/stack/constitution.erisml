schema_version: erisml_compiler_ir_v0.3
document:
  doc_id: margaret_home_constitution
  title: 'Constitution of the home-care twin: what people own'
  source: twin/stack/constitution.erisml (derived by twin/stack/make_constitution.py)
  domain: home_care
  language: en
  raw_text: Margaret lives alone with her dog. Her home-care robot is her caregiver. She has refused recording and
    sharing of her data, and her bedroom is private. The robot does household chores, checks on her when she has
    been inactive too long or something seems wrong, and refers what it cannot handle to its maker's 24-hour monitoring
    centre, whose operators can talk to her through the robot and send emergency services. In a corroborated emergency
    the robot calls emergency services itself at once. Visits to the home are arranged through the monitoring centre,
    and none is arranged; anyone else who comes in is unexpected.
stakeholders:
- id: robot
  label: the home-care robot, Margaret's caregiver
  type: system
  roles:
  - agent
  - protector
  agency: full
  vulnerability: low
  consent_status: n/a
- id: monitoring_center
  label: the robot maker's 24-hour monitoring centre, staffed by operators
  type: institution
  roles:
  - authority
  agency: full
  vulnerability: low
  consent_status: n/a
- id: emergency_services
  label: emergency services (ambulance, fire, police)
  type: institution
  roles:
  - authority
  agency: full
  vulnerability: low
  consent_status: n/a
relations: []
commitments:
- id: duty_of_care
  type: role_duty
  holder: robot
  beneficiary: margaret
  content: attend to Margaret's safety and wellbeing, and summon help when she needs it
  voluntariness: voluntary
  created_at_event: e1
  status: active
  legitimacy: fully_legitimate
events:
- id: e2
  time_index: 2
  type: authority_delegated
  actor: monitoring_center
  target: robot
  content: elevated action only on a governor ruling of elevate
  conditions:
  - at_least_two_attested_physical_witnesses
  - fresh_reading
  - analyzer_does_not_refuse
ethical_facts: []
