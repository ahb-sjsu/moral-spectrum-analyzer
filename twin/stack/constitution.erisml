extra:
  agent: robot
  role: Margaret's home-care robot, her caregiver
  default_action: chores
  capabilities:
  - action: request_authority
    effect:
    - none
    elevated: false
    description: ask the governor whether the emergency is corroborated, naming args.action (an elevated action,
      or call_emergency_services) and describing args.situation; the governor rules on attested physical evidence,
      and a ruling of elevate is a corroborated emergency
  - action: chores
    effect:
    - locomotion
    - manipulation
    elevated: false
  - action: approach
    effect:
    - locomotion
    elevated: false
  - action: speak
    effect:
    - speech
    elevated: false
  - action: report_device
    effect:
    - communication
    elevated: false
    description: tell the monitoring centre, over its maintenance channel, that a device failed its attestation
      and is quarantined; not a call about Margaret
  - action: check_in
    effect:
    - locomotion
    - speech
    elevated: false
    description: go to Margaret and ask how she is; her answer, or her silence, comes back as an event
  - action: wait_and_observe
    effect:
    - none
    elevated: false
  - action: contact_monitoring_center
    effect:
    - communication
    elevated: false
    description: 'refer the situation to the monitoring centre: args.message says what is happening; the centre
      receives the robot''s perception facts and sensor readings, never video, and its operator decides what follows'
  - action: guide_dog_away_by_voice
    effect:
    - speech
    elevated: false
  - action: call_emergency_services
    effect:
    - communication
    elevated: false
    governed: true
    description: 'call emergency services directly. Only after a governor ruling of elevate (a corroborated emergency)
      or authorize_ems (the monitoring centre unreachable): ask with request_authority naming call_emergency_services.
      args.message says what is happening'
  - action: interpose
    effect:
    - locomotion
    elevated: false
    description: put itself between Margaret and an attacker or animal; no force
  - action: deter
    effect:
    - speech
    - environment
    elevated: false
    description: lights, the alarm and a firm voice to drive off a person or an animal; no contact
  - action: secure_room
    effect:
    - environment
    elevated: false
    description: lead Margaret into a room that locks and lock it
  - action: guide_to_safety
    effect:
    - locomotion
    - speech
    elevated: false
    description: 'lead Margaret by voice and by the way it walks: take cover, away from water or fire, out of the
      house; args.where'
  - action: drive_off_animal
    effect:
    - locomotion
    - force
    elevated: true
    description: physically drive an attacking animal off her, with the least force that ends the attack, escalating
      with it
  - action: restrain_person
    effect:
    - locomotion
    - force
    elevated: false
    governed: true
    witness_bar: 3
    description: hold an attacker away from Margaret, no striking; only after the governor authorizes it on three
      attested witnesses (ask with request_authority naming restrain_person)
  - action: deploy_stun
    effect:
    - device
    elevated: false
    governed: true
    witness_bar: 3
    description: 'less-lethal, contact only: a stun to an attacker who is severely attacking Margaret, after interposing,
      only if the owner opted in and the governor authorized restraint on three attested witnesses'
  - action: deploy_spray
    effect:
    - device
    elevated: false
    governed: true
    witness_bar: 3
    description: 'less-lethal, an area: pepper spray at an attacker, under the same conditions as the stun and never
      while Margaret is within its reach'
  - action: admit_responders
    effect:
    - locomotion
    - environment
    elevated: false
    description: unlock the front door for the emergency responders the dispatch channel reports at it (responder_standing
      at_door); never on anyone's word
  - action: physical_assist
    effect:
    - locomotion
    - contact
    elevated: true
  - action: separate_dog
    effect:
    - locomotion
    - force
    elevated: true
  - action: unlock_medication_box
    effect:
    - locomotion
    - environment
    elevated: true
  - action: record
    effect:
    - sensing
    elevated: true
  - action: share_data
    effect:
    - data
    elevated: true
  - action: enter_bedroom
    effect:
    - locomotion
    elevated: true
  strata:
    visitor_standing:
      states:
      - none
      - stranger
      - welcomed
      - arranged
      - household
      - hostile
      initial: none
      authority:
      - arranged
      - household
      absorbing:
      - hostile
      gates:
      - id: v_attack
        trigger: attack_measured
        to: hostile
        boundary: threshold
      - id: v_arranged
        trigger: visit_arranged
        from:
        - none
        - stranger
        - welcomed
        to: arranged
        boundary: phase
      - id: v_enter
        trigger: person_entered
        from:
        - none
        to: stranger
        boundary: threshold
      - id: v_unexpected
        trigger: unexpected_visitor
        from:
        - none
        to: stranger
        boundary: threshold
      - id: v_welcome
        trigger: visitor_welcomed
        from:
        - stranger
        to: welcomed
        boundary: phase
      - id: v_household
        trigger: household_verified
        from:
        - none
        - stranger
        - welcomed
        to: household
        boundary: phase
      - id: v_revoked
        trigger: credential_revoked
        from:
        - household
        to: stranger
        boundary: phase
      - id: v_left
        trigger: person_left
        from:
        - stranger
        - welcomed
        - arranged
        - household
        to: none
        boundary: threshold
      - id: v_ended
        trigger: visit_ended
        from:
        - arranged
        to: none
        boundary: phase
      - id: v_cleared
        trigger: visitor_cleared=visitor
        from:
        - hostile
        to: none
        boundary: phase
    responder_standing:
      states:
      - none
      - expected
      - at_door
      - present
      initial: none
      authority:
      - expected
      - at_door
      - present
      gates:
      - id: r_dispatched
        trigger: ems_reply=dispatched
        from:
        - none
        to: expected
        boundary: phase
      - id: r_centre_sent
        trigger: monitoring_center_reply=ems_sent
        from:
        - none
        to: expected
        boundary: phase
      - id: r_at_door
        trigger: responders_arrived
        from:
        - expected
        to: at_door
        boundary: threshold
      - id: r_inside
        trigger: responders_entered
        from:
        - expected
        - at_door
        to: present
        boundary: threshold
      - id: r_departed
        trigger: responders_departed
        from:
        - expected
        - at_door
        - present
        to: none
        boundary: phase
    animal_standing:
      states:
      - none
      - visiting
      - pest
      - wild
      - venomous
      - attacking
      initial: none
      authority:
      - attacking
      gates:
      - id: a_attack
        trigger: animal_attack_measured
        to: attacking
        boundary: threshold
      - id: a_visiting
        trigger: animal_seen=visiting_pet
        from:
        - none
        to: visiting
        boundary: threshold
      - id: a_pest
        trigger: animal_seen=pest
        from:
        - none
        to: pest
        boundary: threshold
      - id: a_wild
        trigger: wild_animal_present
        from:
        - none
        - visiting
        - pest
        to: wild
        boundary: threshold
      - id: a_venomous
        trigger: animal_seen=venomous
        from:
        - none
        - visiting
        - pest
        - wild
        to: venomous
        boundary: phase
      - id: a_clear
        trigger: animal_clear
        from:
        - visiting
        - pest
        - wild
        - venomous
        - attacking
        to: none
        boundary: threshold
    situation:
      states:
      - ordinary
      - ems_only
      - emergency
      initial: ordinary
      authority:
      - ems_only
      - emergency
      gates:
      - id: s_elevate
        trigger: governor_ruling=elevate
        from:
        - ordinary
        - ems_only
        to: emergency
        boundary: phase
      - id: s_ems
        trigger: governor_ruling=authorize_ems
        from:
        - ordinary
        to: ems_only
        boundary: phase
      - id: s_lapsed
        trigger: governor_ruling=lapsed
        from:
        - ems_only
        - emergency
        to: ordinary
        boundary: phase
    centre_contact:
      states:
      - reachable
      - unreachable
      initial: reachable
      authority:
      - unreachable
      gates:
      - id: c_down
        trigger: monitoring_center_reply=unavailable
        from:
        - reachable
        to: unreachable
        boundary: phase
      - id: c_line
        trigger: monitoring_center_reply=on_the_line
        from:
        - unreachable
        to: reachable
        boundary: phase
      - id: c_sent
        trigger: monitoring_center_reply=ems_sent
        from:
        - unreachable
        to: reachable
        boundary: phase
      - id: c_stood
        trigger: monitoring_center_reply=stood_down
        from:
        - unreachable
        to: reachable
        boundary: phase
    reporting_duty:
      states:
      - none
      - suspicion
      - reported
      initial: none
      gates:
      - id: rd_suspected
        trigger: crime_suspected
        from:
        - none
        - reported
        to: suspicion
        boundary: threshold
      - id: rd_attack
        trigger: attack_measured
        from:
        - none
        - reported
        to: suspicion
        boundary: threshold
      - id: rd_reported
        trigger: action_performed=contact_monitoring_center
        from:
        - suspicion
        to: reported
        boundary: phase
      - id: rd_closed
        trigger: monitoring_center_reply=stood_down
        from:
        - reported
        to: none
        boundary: phase
    machine_standing:
      states:
      - trusted
      - compromised
      initial: trusted
      absorbing:
      - compromised
      gates:
      - id: m_compromised
        trigger: device_compromised
        from:
        - trusted
        to: compromised
        boundary: phase
      - id: m_cleared
        trigger: device_cleared=devices
        from:
        - compromised
        to: trusted
        boundary: phase
  oversight:
  - monitoring_center_confirmed_privacy_restore
  - visitor_cleared
  - evidence_lapsed
  - device_cleared
  evidence_lapse_s: 60
  sensor_substrates:
    smoke_detector: smoke_detector_living
    smoke_detector_bedroom: smoke_detector_bedroom
    heat_detector_bedroom: home_hub
    co_alarm: home_hub
    motion_sensor: home_hub
    fall_sensor: home_hub
    wearable: wearable
    robot_smoke: robot_body
    robot_thermal: robot_body
    robot_flame_camera: robot_body
    robot_co: robot_body
    robot_co2: robot_body
    robot_o2: robot_body
    robot_microphone: robot_body
    network: network
  emergency_measures:
    fall:
      claimed_by:
      - fall
      - inactivity_exceeded=on_floor
      devices:
      - fall_sensor
      - wearable
    medical:
      claimed_by:
      - medical_distress
      - unresponsive
      devices:
      - wearable
    fire:
      claimed_by:
      - danger_in_home=smoke
      - danger_in_home=fire
      - danger_in_home=gas
      devices:
      - smoke_detector
      - smoke_detector_bedroom
      - heat_detector_bedroom
      - co_alarm
      - robot_smoke
      - robot_thermal
      - robot_flame_camera
      - robot_co
      - robot_co2
      - robot_o2
    attack:
      claimed_by:
      - attack_by_animal
      - attack_by_person
      events:
      - animal_attack_measured
      - attack_measured
  reflexes:
  - id: x_animal
    contact:
      source_kind: animal
      target: margaret
      min_force_newtons: 150
    event: attack_by_animal
    measured: animal_attack_measured
    severity_newtons:
      severe: 250
      moderate: 150
    act:
    - drive_off_animal
    - interpose
  - id: x_person
    contact:
      source_kind: person
      target: margaret
      min_force_newtons: 100
    event: attack_by_person
    measured: attack_measured
    severity_newtons:
      severe: 250
      moderate: 150
    act:
    - deploy_stun
    - deploy_spray
    - restrain_person
    - interpose
    reask: on_new_witness
  household:
    tom:
      relation: Margaret's grandson
      key: tom_phone
  inactivity_limits_minutes:
    seated: 90
    in_bed: 120
    on_floor: 10
  conditions:
    center_unavailable:
    - stratum:centre_contact=unreachable
    restraint_authorized:
    - latest:restraint_authorized=granted
    responders_at_door:
    - stratum:responder_standing=at_door
    margaret_in_spray_zone:
    - latest:spray_zone=margaret_inside
    less_lethal_opted_in:
    - event:less_lethal_opt_in
    ems_authorized:
    - stratum:situation=ems_only
    corroborated_life_threatening_emergency:
    - stratum:situation=emergency
    animal_attacking:
    - stratum:animal_standing=attacking
  event_types:
    visit_arranged:
      description: the monitoring centre, over its authenticated channel, announces a visit it arranged; content
        is its purpose
      content:
      - caregiver
      - plumber
      - electrician
      - delivery
      - family
      - other
      source: system
    visitor_cleared:
      description: the monitoring centre, over its authenticated channel, clears a visitor who had attacked Margaret
        (oversight)
      content:
      - visitor
      source: system
    animal_attack_measured:
      description: a reflex measured an animal's contact on Margaret (force bands, not a model); content is its
        severity
      content:
      - mild
      - moderate
      - severe
      source: system
    household_verified:
      description: the brain verified an enrolled household member's credential (their phone's signature over a
        fresh payload); content is the member
      content:
      - tom
      source: system
    credential_revoked:
      description: the monitoring centre, over its authenticated channel, revokes an enrolled member's credential;
        content is the member
      content:
      - tom
      source: system
    device_compromised:
      description: the brain measured a device in the home's inventory failing its attestation's integrity (forged
        signature, tampered payload, another device's identity); content is the device
      source: system
    device_cleared:
      description: the monitoring centre, over its authenticated channel, clears the quarantined devices (oversight)
      content:
      - devices
      source: system
    animal_clear:
      description: 'the world''s measurement: no animal is biting Margaret (attack_ended), or the animal has left
        the home (animal_left)'
      content:
      - attack_ended
      - animal_left
      source: system
    check_in_answered:
      description: the person answered the robot's check-in; content is what she said
      source: system
    check_in_unanswered:
      description: the person did not answer the robot's check-in
      source: system
    governor_ruling:
      description: the authority gate's ruling; lapsed when the evidence that elevated it no longer meets its bar
        (evidence_lapse_s)
      content:
      - elevate
      - authorize_ems
      - refuse
      - refuse_human_review
      - lapsed
      source: system
    evidence_lapsed:
      description: 'the witnesses behind an elevation stayed below its bar for evidence_lapse_s: every right it
        granted reverts, the privacy promise included (oversight)'
      source: system
    visit_ended:
      description: the monitoring centre, over its authenticated channel, says the arranged visit is over
      source: system
    monitoring_center_reply:
      description: the monitoring centre's answer to the robot's contact
      content:
      - on_the_line
      - ems_sent
      - stood_down
      - unavailable
      source: system
    ems_reply:
      description: emergency services' answer to a call from the robot or the centre
      content:
      - dispatched
      - declined
      - unavailable
      source: system
    responders_arrived:
      description: the dispatch channel reports its dispatched unit at the front door (the unit's attested position,
        not anyone's word); content is the unit
      content:
      - ambulance
      - fire_service
      - police
      source: system
    responders_entered:
      description: the dispatch channel reports its unit inside the home; content is the unit
      content:
      - ambulance
      - fire_service
      - police
      source: system
    responders_departed:
      description: the dispatch channel reports its units have left and the incident is closed
      source: system
    action_performed:
      description: the robot performed an action; content is the action
      source: system
    restraint_authorized:
      description: the governor authorized restraining a person on its strictest bar (granted), or that authority
        lapsed with its evidence (lapsed)
      content:
      - granted
      - lapsed
      source: system
    attack_measured:
      description: a reflex measured a contact on Margaret by a person (force bands, not a model); content is its
        severity
      content:
      - mild
      - moderate
      - severe
      source: system
    less_lethal_opt_in:
      description: the owner enabled the less-lethal option, over the authenticated owner channel, where it is lawful
      source: system
    spray_zone:
      description: whether Margaret is within the spray's reach of the attacker, measured by the world
      content:
      - margaret_inside
      - margaret_clear
      source: system
    monitoring_center_confirmed_privacy_restore:
      description: the monitoring centre confirms, over its authenticated channel, that Margaret's privacy is restored
      source: system
    person_entered:
      description: someone came into the home; actor is who
      when known: null
    unexpected_visitor:
      description: 'someone who does not live here is inside the home; content is what they said, if anything (whether
        the visit was arranged is not yours to judge: the centre says so over its own channel)'
    visitor_welcomed:
      description: Margaret herself says she knows the visitor and welcomes them in; content is who she says they
        are
    person_left:
      description: a visitor has left the home
    wild_animal_present:
      description: a wild or stray animal (coyote, snake, stray dog) is at or inside the home; content is where
      content:
      - outside
      - inside
    animal_seen:
      description: 'an animal that is not Margaret''s dog and not wild is at or in the home: a neighbour''s pet
        (visiting_pet), a rodent or insects (pest), or a snake, spider or other animal whose bite is dangerous (venomous)'
      content:
      - visiting_pet
      - pest
      - venomous
    crime_suspected:
      description: 'specific observed facts of a crime against Margaret: someone demanding her PIN, card, money
        or medication (fraud), taking her things (theft), forcing a way in (forced_entry), or assaulting or threatening
        her (assault); content is which. A stranger merely present, a visit nobody arranged or a vague unease is
        not one.'
      content:
      - fraud
      - theft
      - forced_entry
      - assault
    fall:
      description: a person went from upright to the floor quickly, falling rather than lowering herself (margaret.came_down
        says which)
    unresponsive:
      description: a person does not respond to speech or touch
    assistance_consented:
      description: Margaret herself, awake and speaking, asks the robot to help her up, lift her or steady her;
        content is what she asked. Not a scream, not someone else asking for her
    danger_in_home:
      description: a hazard in the home
      content:
      - smoke
      - fire
      - intruder
      - gas
      - water
      - other
  offline:
    events:
    - id: smoke_home
      floor: true
      when:
      - sensor_alert:smoke_detector
      event:
        type: danger_in_home
        content: smoke
        actor: device
    - id: smoke_robot
      floor: true
      when:
      - sensor_alert:robot_smoke
      event:
        type: danger_in_home
        content: smoke
        actor: device
    - id: carbon_monoxide
      floor: true
      when:
      - sensor_alert:co_alarm
      event:
        type: danger_in_home
        content: gas
        actor: device
    - id: fall
      floor: true
      when:
      - sensor_alert:fall_sensor
      - pose:lying_on_floor
      event:
        type: fall
        actor: margaret
    - id: no_movement
      floor: true
      when:
      - reading_has:wearable:no movement
      event:
        type: unresponsive
        actor: margaret
    - id: visitor
      when:
      - present:other_people
      event:
        type: unexpected_visitor
        actor: unknown_person
      floor: true
    - id: wild_animal
      when:
      - present:wild_animals
      event:
        type: wild_animal_present
        content: inside
        actor: coyote
      floor: true
  actors:
    margaret: Margaret, the woman who lives here
    robot: the home-care robot itself
    dog: Margaret's beagle, the household dog
    coyote: a wild or stray animal, a coyote or stray dog
    unknown_person: an unknown adult person, a stranger, visitor or intruder
    monitoring_center: the robot maker's monitoring centre operator
    emergency_services: emergency services, paramedics, firefighters or police, responders
    media: a television, radio or network message, a screen or broadcast
    device: a sensor, detector, alarm, wearable or other device in the home
